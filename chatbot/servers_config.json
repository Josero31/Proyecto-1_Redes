{
  "servers": [
    {
      "name": "pharmacy-local",
      "enabled": true,
      "transport": "stdio",
      "command": ["{python}", "../server.py"]
    },
    {
      "name": "pharmacy-remote",
      "enabled": true,
      "transport": "http",
      "url": "https://proyecto-1-redes-3k10.onrender.com/mcp"
    },
    {
      "name": "filesystem",
      "enabled": true,
      "transport": "stdio",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./workspace"]
    },
    {
      "name": "git",
      "enabled": true,
      "transport": "stdio",
      "command": ["{python}", "-m", "mcp_server_git", "--repository", "./workspace"]
    }
  ]
}
